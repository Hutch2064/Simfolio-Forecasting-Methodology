diff --git a/include/vinecopulib/misc/tools_stats.hpp b/include/vinecopulib/misc/tools_stats.hpp
index 0faa5c2..7669e31 100644
--- a/include/vinecopulib/misc/tools_stats.hpp
+++ b/include/vinecopulib/misc/tools_stats.hpp
@@ -60,6 +60,23 @@ qnorm(const Eigen::MatrixXd& x)
 inline Eigen::MatrixXd
 dt(const Eigen::MatrixXd& x, double nu)
 {
+  if (nu >= 2.0 && nu <= 50.0) {
+    // Boost 1.84's identical per-observation arithmetic with its invariant
+    // normalizer evaluated once. The general distribution fallback remains.
+    const double normalizer = std::sqrt(nu) * boost::math::beta(nu / 2, 0.5);
+    auto f = [nu, normalizer](double y) {
+      if (std::isinf(y)) return 0.0;
+      const double basem1 = y * y / nu;
+      double result;
+      if (basem1 < 0.125) {
+        result = std::exp(-boost::math::log1p(basem1) * (1 + nu) / 2);
+      } else {
+        result = std::pow(1 / (1 + basem1), (nu + 1) / 2);
+      }
+      return result / normalizer;
+    };
+    return tools_eigen::unaryExpr_or_nan(x, f);
+  }
   boost::math::students_t dist(nu);
   auto f = [&dist](double y) { return boost::math::pdf(dist, y); };
   return tools_eigen::unaryExpr_or_nan(x, f);
@@ -89,6 +106,37 @@ inline Eigen::MatrixXd
 qt(const Eigen::MatrixXd& x, double nu)
 {
   boost::math::students_t dist(nu);
+  // Two empirical-rank columns contain the same exact probability grid.
+  // Evaluate each distinct argument once; conditional/non-grid data use the
+  // original Boost evaluator without approximations or interpolation.
+  if (x.cols() == 2 && x.rows() >= 128) {
+    const double denominator = static_cast<double>(x.rows()) + 1.0;
+    Eigen::Matrix<Eigen::Index, Eigen::Dynamic, Eigen::Dynamic> ranks(x.rows(), 2);
+    bool on_grid = true;
+    for (Eigen::Index i = 0; i < x.size(); ++i) {
+      const double value = x.data()[i];
+      if (!std::isfinite(value) || value <= 0.0 || value >= 1.0) {
+        on_grid = false;
+        break;
+      }
+      const auto rank = static_cast<Eigen::Index>(std::round(value * denominator));
+      if (rank < 1 || rank > x.rows() ||
+          value != static_cast<double>(rank) / denominator) {
+        on_grid = false;
+        break;
+      }
+      ranks.data()[i] = rank - 1;
+    }
+    if (on_grid) {
+      Eigen::VectorXd grid(x.rows());
+      for (Eigen::Index i = 0; i < x.rows(); ++i) {
+        grid(i) = boost::math::quantile(dist, (static_cast<double>(i) + 1.0) / denominator);
+      }
+      Eigen::MatrixXd result(x.rows(), 2);
+      for (Eigen::Index i = 0; i < x.size(); ++i) result.data()[i] = grid(ranks.data()[i]);
+      return result;
+    }
+  }
   auto f = [&dist](double y) { return boost::math::quantile(dist, y); };
   return tools_eigen::unaryExpr_or_nan(x, f);
 }
